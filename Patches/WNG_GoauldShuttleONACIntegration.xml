<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>ONAC</li>
    </mods>
    <match Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="WNG_AlkeshTransport"]/costList</xpath>
        <value><ONAC_Naquadah>85</ONAC_Naquadah></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="WNG_AlkeshTransport"]/comps/li[@Class="CompProperties_Refuelable"]/fuelFilter/thingDefs/li</xpath>
        <value><li>ONAC_LiquidNaquadria</li></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="WNG_AlkeshTransport"]/comps/li[@Class="CompProperties_Refuelable"]/fuelLabel</xpath>
        <value><fuelLabel>Liquid Naquadria</fuelLabel></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="WNG_AlkeshTransport"]/comps/li[@Class="CompProperties_Refuelable"]/fuelGizmoLabel</xpath>
        <value><fuelGizmoLabel>Liquid Naquadria</fuelGizmoLabel></value>
      </li>

      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="WNG_GoauldDeathGlider"]/costList</xpath>
        <value><ONAC_Naquadah>55</ONAC_Naquadah></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="WNG_GoauldDeathGlider"]/comps/li[@Class="CompProperties_Refuelable"]/fuelFilter/thingDefs/li</xpath>
        <value><li>ONAC_LiquidNaquadria</li></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="WNG_GoauldDeathGlider"]/comps/li[@Class="CompProperties_Refuelable"]/fuelLabel</xpath>
        <value><fuelLabel>Liquid Naquadria</fuelLabel></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="WNG_GoauldDeathGlider"]/comps/li[@Class="CompProperties_Refuelable"]/fuelGizmoLabel</xpath>
        <value><fuelGizmoLabel>Liquid Naquadria</fuelGizmoLabel></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="WNG_GoauldDeathGlider_NPC"]/comps/li[@Class="CompProperties_Refuelable"]/fuelFilter/thingDefs/li</xpath>
        <value><li>ONAC_LiquidNaquadria</li></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="WNG_GoauldDeathGlider_NPC"]/comps/li[@Class="CompProperties_Refuelable"]/fuelLabel</xpath>
        <value><fuelLabel>Liquid Naquadria</fuelLabel></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="WNG_GoauldDeathGlider_NPC"]/comps/li[@Class="CompProperties_Refuelable"]/fuelGizmoLabel</xpath>
        <value><fuelGizmoLabel>Liquid Naquadria</fuelGizmoLabel></value>
      </li>



      <li Class="PatchOperationAdd">
        <xpath>Defs/ResearchProjectDef[defName="WNG_GoauldShuttles"]/prerequisites</xpath>
        <value><li>ONAC_NaquadahLiquefaction</li></value>
      </li>
    </operations>
    </match>
  </Operation>
</Patch>
