<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <AbilityDef>
    <defName>WNG_SovereignLatticeDirective</defName>
    <label>issue lattice sovereignty</label>
    <description>The implanted Sovereign Neural Lattice can bind or release one targeted block Replicator while maintaining its other existing bindings. Acquisition is local and explicit, and normal EMP or containment interruption still applies.</description>
    <iconPath>UI/WNG/Abilities/NeuralInterface</iconPath>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>2.5</warmupTime>
      <range>24</range>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetMechs>true</canTargetMechs>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps><li Class="WraithNaniteGravtech.CompProperties_AbilitySovereignLatticeDirective" /></comps>
  </AbilityDef>
</Defs>
