<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <AbilityDef>
    <defName>WNG_ReplicatorQueenDirective</defName>
    <label>sovereign directive</label>
    <description>Assert or release the exact Replicator Queen's authority over one physical block Replicator. Acquisition changes the block's real faction and controller domain while preserving its exact previous state for later release. EMP or containment suppresses the signal without erasing ownership.</description>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <cooldownTicksRange>600~600</cooldownTicksRange>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>20</range>
      <warmupTime>1.5</warmupTime>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetSelf>false</canTargetSelf>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetMechs>true</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_AbilityReplicatorQueenDirective" />
    </comps>
  </AbilityDef>
</Defs>
