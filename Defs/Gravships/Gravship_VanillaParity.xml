    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded><constructionSkillPrerequisite>8</constructionSkillPrerequisite><canBeUsedUnderRoof>false</canBeUsedUnderRoof>
    <statBases><MaxHitPoints>350</MaxHitPoints><Mass>42</Mass><WorkToBuild>9000</WorkToBuild><Flammability>0.1</Flammability><Beauty>2</Beauty></statBases>
    <costList><WNG_Biomass>95</WNG_Biomass><GravlitePanel>35</GravlitePanel></costList>
