<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Wraith reachability support: native Odyssey SignalJammer role, powered only by the Wraith neural grid. -->
  <ThingDef ParentName="GravshipComponentBase">
    <defName>WNG_WraithSignalVeil</defName>
    <label>wraith signal veil organ</label>
    <description>A living electromagnetic masking organ woven into a Wraith gravship. It performs Odyssey's native signal-jammer role while drawing only from the isolated Wraith neural grid.</description>
    <designationCategory>Misc</designationCategory><uiOrder>2240</uiOrder><tickerType>Normal</tickerType>
    <graphicData><graphicClass>Graphic_Multi</graphicClass><texPath>Things/Building/Wraith/Gravship/WNG_WraithSignalVeil</texPath><drawSize>(2,2)</drawSize></graphicData>
    <size>(2,2)</size><fillPercent>0.6</fillPercent><passability>PassThroughOnly</passability><pathCost>20</pathCost><canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded><constructionSkillPrerequisite>8</constructionSkillPrerequisite><resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
    <statBases><MaxHitPoints>350</MaxHitPoints><Mass>48</Mass><WorkToBuild>8500</WorkToBuild><Flammability>0.1</Flammability><Beauty>3</Beauty></statBases>
    <costList Inherit="False"><WNG_Biomass>90</WNG_Biomass><GravlitePanel>45</GravlitePanel></costList>
    <researchPrerequisites Inherit="False"><li>WNG_HiveGravshipArchitecture</li></researchPrerequisites>
    <placeWorkers Inherit="False"><li>WraithNaniteGravtech.PlaceWorker_RequireWraithGravshipSubstructure</li></placeWorkers>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipFacility"><family>Wraith</family><requiresFamilyPower>true</requiresFamilyPower><requiresLOS>false</requiresLOS><componentTypeDef>SignalJammer</componentTypeDef><maxSimultaneous>1</maxSimultaneous><maxDistance>500</maxDistance></li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGFamilyPowerNode"><family>Wraith</family><role>Consumer</role><demandWatts>800</demandWatts></li>
    </comps>
  </ThingDef>

  <!-- Asuran reachability support: same native role, but family-isolated. -->
  <ThingDef ParentName="GravshipComponentBase">
    <defName>WNG_AsuranSignalJammer</defName>
    <label>Asuran signal nullifier</label>
    <description>A precision Asuran signature-control array. It performs Odyssey's native signal-jammer role while remaining electrically isolated inside the Asuran family lattice.</description>
    <designationCategory>Misc</designationCategory><uiOrder>2241</uiOrder><tickerType>Normal</tickerType>
    <graphicData><graphicClass>Graphic_Multi</graphicClass><texPath>Things/Building/Precursor/Gravship/WNG_AsuranSignalJammer</texPath><drawSize>(2,2)</drawSize></graphicData>
    <size>(2,2)</size><fillPercent>0.6</fillPercent><passability>PassThroughOnly</passability><pathCost>20</pathCost><canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded><constructionSkillPrerequisite>9</constructionSkillPrerequisite><resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
    <statBases><MaxHitPoints>450</MaxHitPoints><Mass>62</Mass><WorkToBuild>11000</WorkToBuild><Flammability>0</Flammability><Beauty>7</Beauty></statBases>
    <costList Inherit="False"><Plasteel>130</Plasteel><GravlitePanel>55</GravlitePanel><ComponentSpacer>4</ComponentSpacer></costList>
    <researchPrerequisites Inherit="False"><li>WNG_AsuranGravshipArchitecture</li></researchPrerequisites>
    <placeWorkers Inherit="False"><li>WraithNaniteGravtech.PlaceWorker_RequireAsuranGravshipSubstructure</li></placeWorkers>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipFacility"><family>Asuran</family><requiresFamilyPower>true</requiresFamilyPower><requiresLOS>false</requiresLOS><componentTypeDef>SignalJammer</componentTypeDef><maxSimultaneous>1</maxSimultaneous><maxDistance>500</maxDistance></li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGFamilyPowerNode"><family>Asuran</family><role>Consumer</role><demandWatts>900</demandWatts></li>
    </comps>
  </ThingDef>

  <!-- Asuran defensive identity: real Odyssey-style projectile interception, not a Wraith reskin. -->
  <ThingDef ParentName="GravshipComponentBase">
    <defName>WNG_PrecursorShieldEmitter</defName>
    <label>Asuran gravship shield emitter</label>
    <description>A precision Asuran defensive-field emitter. It uses RimWorld's native projectile-interceptor lifecycle—activation, depletion, recharge, EMP collapse and projectile interception—but its energy comes only from the isolated Asuran gravship lattice.</description>
    <designationCategory>Misc</designationCategory><uiOrder>2250</uiOrder><tickerType>Normal</tickerType><drawerType>MapMeshAndRealTime</drawerType><drawOffscreen>true</drawOffscreen>
    <graphicData><graphicClass>Graphic_Single</graphicClass><texPath>Things/Building/Precursor/Gravship/WNG_PrecursorShieldEmitter</texPath><drawSize>(3,3)</drawSize></graphicData>
    <size>(3,3)</size><fillPercent>0.6</fillPercent><passability>PassThroughOnly</passability><pathCost>20</pathCost><canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded><constructionSkillPrerequisite>10</constructionSkillPrerequisite><resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed><specialDisplayRadius>27.9</specialDisplayRadius>
    <statBases><MaxHitPoints>430</MaxHitPoints><Mass>62</Mass><WorkToBuild>14000</WorkToBuild><Flammability>0</Flammability><Beauty>9</Beauty></statBases>
    <costList Inherit="False"><Plasteel>240</Plasteel><GravlitePanel>100</GravlitePanel><ComponentSpacer>8</ComponentSpacer></costList>
    <researchPrerequisites Inherit="False"><li>WNG_AsuranGravshipArchitecture</li><li>WNG_VacuumEnergyContainment</li></researchPrerequisites>
    <placeWorkers Inherit="False"><li>WraithNaniteGravtech.PlaceWorker_RequireAsuranGravshipSubstructure</li></placeWorkers>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipFacility"><family>Asuran</family><requiresFamilyPower>true</requiresFamilyPower><requiresLOS>false</requiresLOS><maxSimultaneous>1</maxSimultaneous><maxDistance>500</maxDistance></li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Interactable">
        <compClass>WraithNaniteGravtech.CompInteractable_WNGAsuranGravshipShield</compClass><ticksToActivate>120</ticksToActivate><jobString>activate</jobString><activateTexPath>UI/Commands/ActivateGravshipShield</activateTexPath><soundActivate>WNG_PrecursorShield</soundActivate><requiresPower>false</requiresPower>
        <targetingParameters><canTargetBuildings>false</canTargetBuildings><canTargetAnimals>false</canTargetAnimals><canTargetMechs>false</canTargetMechs><onlyTargetControlledPawns>true</onlyTargetControlledPawns></targetingParameters>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGAsuranGravshipShield">
        <radius>27.9</radius><interceptGroundProjectiles>true</interceptGroundProjectiles><interceptAirProjectiles>true</interceptAirProjectiles><color>(0.33,0.82,1.0)</color>
        <reactivateEffect>BulletShieldGenerator_Reactivate</reactivateEffect><activeSound>BulletShield_Ambience</activeSound><hitPoints>900</hitPoints><hitPointsRestoreInstantlyAfterCharge>false</hitPointsRestoreInstantlyAfterCharge><startWithMaxHitPoints>false</startWithMaxHitPoints><chargeDurationTicks>8000</chargeDurationTicks><minIdleAlpha>0.2</minIdleAlpha><drawWithNoSelection>true</drawWithNoSelection><disarmedByEmpForTicks>1500</disarmedByEmpForTicks><gizmoTipKey>GravshipShieldTip</gizmoTipKey><alwaysShowHitpointsGizmo>true</alwaysShowHitpointsGizmo><rechargeHitPointsIntervalTicks>75</rechargeHitPointsIntervalTicks><activated>true</activated><activeDuration>6500</activeDuration>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGFamilyPowerNode"><family>Asuran</family><role>Consumer</role><demandWatts>2600</demandWatts></li>
          <li Class="WraithNaniteGravtech.CompProperties_AsuranArchiveRepair"><repairIntervalTicks>750</repairIntervalTicks><healPerPulse>4</healPerPulse><archiveRadius>55</archiveRadius></li>
    </comps>
  </ThingDef>
</Defs>
