  <ThingDef ParentName="BuildingBase">
    <defName>WNG_WraithCruiser</defName><label>Wraith cruiser</label>
    <description>A medium Wraith cruiser organism grown for long-range assault and troop transport. It is the heaviest shuttle-scale Wraith craft before a true Hive gravship, with deep bio-fluid organs and sustained living-hull repair from carried Biomass.</description>
    <thingClass>Building_PassengerShuttle</thingClass><preventDroppingThingsOn>true</preventDroppingThingsOn><altitudeLayer>Building</altitudeLayer><pathCost>70</pathCost><blockWind>true</blockWind><passability>PassThroughOnly</passability><fillPercent>0.6</fillPercent><size>(5,7)</size><drawHighlight>true</drawHighlight><highlightColor>(0.18,0.67,0.54)</highlightColor><uiIconScale>1.05</uiIconScale>
    <graphicData><graphicClass>Graphic_Multi</graphicClass><texPath>Things/Building/Wraith/Shuttle/WNG_WraithCruiser</texPath><shaderType>CutoutComplex</shaderType><drawSize>(5.5,7.7)</drawSize><shadowData><volume>(3.3,1.5,5.9)</volume><offset>(-0.1,0,0)</offset></shadowData></graphicData>
    <statBases><MaxHitPoints>1800</MaxHitPoints><Flammability>0.08</Flammability><WorkToBuild>82000</WorkToBuild><Mass>240</Mass><Comfort>0.70</Comfort></statBases>
    <tickerType>Normal</tickerType><designationCategory>Misc</designationCategory><constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <costList><WNG_Biomass>650</WNG_Biomass><GravlitePanel>110</GravlitePanel><ComponentSpacer>8</ComponentSpacer><ShuttleEngine>2</ShuttleEngine></costList>
    <canOverlapZones>true</canOverlapZones><rotatable>true</rotatable><hasInteractionCell>true</hasInteractionCell><interactionCellOffset>(4,0,0)</interactionCellOffset><defaultPlacingRot>East</defaultPlacingRot><selectable>true</selectable><terrainAffordanceNeeded>Light</terrainAffordanceNeeded><soundImpactDefault>BulletImpact_Metal</soundImpactDefault><preventSkyfallersLandingOn>true</preventSkyfallersLandingOn><drawerType>RealtimeOnly</drawerType><repairEffect>ConstructDirt</repairEffect><forceDebugSpawnable>true</forceDebugSpawnable>
    <building><claimable>false</claimable><destroySound>BuildingDestroyed_Wood_Big</destroySound><paintable>false</paintable><isInert>true</isInert><forcedCostLeavings><li MayRequire="Ludeon.RimWorld.Odyssey">ShuttleEngine</li></forcedCostLeavings></building>
    <inspectorTabs><li>ITab_ContentsTransporter</li></inspectorTabs>
    <researchPrerequisites><li>Shuttles</li><li>WNG_CruiserBiology</li></researchPrerequisites>
    <comps>
      <li Class="CompProperties_Shuttle"><shipDef>WNG_Ship_WraithCruiser</shipDef></li>
      <li Class="CompProperties_Launchable"><fuelPerTile>3.0</fuelPerTile><minFuelCost>55</minFuelCost><skyfallerLeaving>WNG_WraithCruiserLeaving</skyfallerLeaving><worldObjectDef>WNG_WraithCruiserWorld</worldObjectDef><cooldownTicks>4800</cooldownTicks><fixedLaunchDistanceMax>125</fixedLaunchDistanceMax><cooldownEndedMessage>{0} is ready to launch again.</cooldownEndedMessage></li>
      <li Class="CompProperties_Transporter"><massCapacity>1650</massCapacity><max1PerGroup>true</max1PerGroup><canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting><pawnLoadedSound>Shuttle_PawnLoaded</pawnLoadedSound><pawnExitSound>Shuttle_PawnExit</pawnExitSound><showMassInInspectString>true</showMassInInspectString></li>
      <li Class="CompProperties_Refuelable"><fuelCapacity>680</fuelCapacity><targetFuelLevelConfigurable>true</targetFuelLevelConfigurable><initialConfigurableTargetFuelLevel>680</initialConfigurableTargetFuelLevel><fuelFilter><thingDefs><li>WNG_WraithBiofluidFuel</li></thingDefs></fuelFilter><fuelLabel>wraith bio-fluid</fuelLabel><fuelGizmoLabel>Bio-fluid</fuelGizmoLabel><consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed><autoRefuelPercent>1</autoRefuelPercent><showFuelGizmo>true</showFuelGizmo><drawOutOfFuelOverlay>false</drawOutOfFuelOverlay><showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle><canEjectFuel>true</canEjectFuel></li>
      <li Class="WraithNaniteGravtech.CompProperties_WraithCraftRegeneration"><repairIntervalTicks>660</repairIntervalTicks><healPerPulse>14</healPerPulse><biomassPerPulse>1.5</biomassPerPulse></li>
      <li Class="CompProperties_AmbientSound"><sound>WNG_WraithDartDrive</sound></li>
    </comps><placeWorkers><li>PlaceWorker_NotUnderRoof</li></placeWorkers><uiOrder>2604</uiOrder>
  </ThingDef>
</Defs>
