<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>WNG_RupturedWraithGrowthVat</defName><label>ruptured Wraith growth vat</label>
    <description>The dead shell of a Wraith gestation organ. Its ruptured tissue cannot gestate pawns, grow implants or be repaired into a functioning Growth Chamber.</description>
    <thingClass>Building</thingClass><graphicData><texPath>Things/Building/Production/WNG_GrowthChamber</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(2.2,1.6)</drawSize></graphicData>
    <size>(2,1)</size><passability>PassThroughOnly</passability><fillPercent>0.55</fillPercent>
    <statBases><MaxHitPoints>180</MaxHitPoints><Mass>35</Mass><Flammability>0.55</Flammability><Beauty>-5</Beauty></statBases>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>WNG_CollapsedWraithFeedingRig</defName><label>collapsed Wraith feeding rig</label>
    <description>A dead feeding apparatus from an abandoned Wraith laboratory. It contains no captive, performs no feeding and cannot be restored into working Wraith infrastructure.</description>
    <thingClass>Building</thingClass><graphicData><texPath>Things/Building/Wraith/Storage/WNG_NutrientNiche</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(1.3,1.8)</drawSize></graphicData>
    <size>(1,2)</size><passability>PassThroughOnly</passability><fillPercent>0.45</fillPercent>
    <statBases><MaxHitPoints>150</MaxHitPoints><Mass>24</Mass><Flammability>0.5</Flammability><Beauty>-6</Beauty></statBases>
  </ThingDef>
</Defs>