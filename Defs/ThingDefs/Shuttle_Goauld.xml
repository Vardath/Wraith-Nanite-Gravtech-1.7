  <ThingDef ParentName="BuildingBase">
    <defName>WNG_AlkeshTransport</defName><label>Al'kesh transport</label>
    <description>A Goa'uld Al'kesh mid-range bomber and transport. Odyssey owns ordinary boarding, cargo, launch and world travel; WNG adds a physical same-map bombing run using the exact craft. It uses Chemfuel when ONAC is absent and ONAC's Goa'uld material/fuel economy when ONAC is installed.</description>
    <thingClass>Building_PassengerShuttle</thingClass><preventDroppingThingsOn>true</preventDroppingThingsOn><altitudeLayer>Building</altitudeLayer><pathCost>50</pathCost><blockWind>true</blockWind><passability>PassThroughOnly</passability><fillPercent>0.5</fillPercent><size>(5,7)</size><drawHighlight>true</drawHighlight><highlightColor>(0.72,0.52,0.22)</highlightColor><uiIconScale>1</uiIconScale>
