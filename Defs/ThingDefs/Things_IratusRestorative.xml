<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>WNG_IratusQueenExtract</defName>
    <label>Iratus queen restorative extract</label>
    <description>A rare glandular sample taken from a living Iratus queen. Its regenerative signaling differs sharply from ordinary Iratus material and can be used to recreate the dangerous Wraith restorative pathway associated with queen feeding.</description>
    <graphicData>
      <texPath>Things/Item/WraithMedical/WNG_IratusQueenExtract</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <rotatable>false</rotatable>
    <statBases>
      <MarketValue>220</MarketValue>
      <Mass>0.04</Mass>
      <MaxHitPoints>45</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>
    <thingCategories><li>ItemsMisc</li></thingCategories>
    <tradeability>Sellable</tradeability>
    <tradeTags><li>ExoticMisc</li></tradeTags>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>WNG_IratusQueenRestorative</defName>
    <recipeMaker IsNull="True" />
    <label>Iratus queen restorative</label>
    <thingCategories Inherit="False"><li>Medicine</li></thingCategories>
    <description>A stabilized Wraith-only restorative derived from live Iratus queen tissue and refined Wraith enzyme. It attempts to trigger the same regenerative pathway once achieved by allowing a queen to feed on a sick Wraith. The reaction is excruciating and usually fatal; surviving Wraith can recover from otherwise catastrophic physical damage.</description>
    <graphicData>
      <texPath>Things/Item/WraithMedical/WNG_IratusQueenRestorative</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <rotatable>false</rotatable>
    <statBases>
      <MarketValue>520</MarketValue>
      <Mass>0.08</Mass>
      <MaxHitPoints>50</MaxHitPoints>
    </statBases>
    <techLevel>Spacer</techLevel>
    <costList>
      <WNG_IratusQueenExtract>1</WNG_IratusQueenExtract>
      <WNG_RefinedWraithEnzyme>1</WNG_RefinedWraithEnzyme>
      <Neutroamine>4</Neutroamine>
      <MedicineIndustrial>1</MedicineIndustrial>
    </costList>
    <tradeability>Sellable</tradeability>
    <tradeTags><li>ExoticMisc</li></tradeTags>
  </ThingDef>

  <HediffDef>
    <defName>WNG_IratusQueenRegeneration</defName>
    <label>Iratus queen regeneration</label>
    <description>The Wraith survived Iratus queen restorative treatment. Its regenerative systems are running at an extreme rate while the queen-derived signaling factors are cleared.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.5</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0.5</painFactor>
        <statFactors>
          <InjuryHealingFactor>8.0</InjuryHealingFactor>
          <ImmunityGainSpeed>2.5</ImmunityGainSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>
