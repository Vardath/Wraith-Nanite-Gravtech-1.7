  <ThingDef Name="WNG_WraithDartBase" ParentName="BuildingBase" Abstract="True">
    <label>Wraith Dart</label><description>A compact Wraith culling and transport craft grown around a living gravitic drive. It uses Odyssey's native passenger-shuttle lifecycle and cultivated Wraith bio-fluid propulsion.</description>
    <thingClass>Building_PassengerShuttle</thingClass><preventDroppingThingsOn>true</preventDroppingThingsOn><altitudeLayer>Building</altitudeLayer><pathCost>50</pathCost><blockWind>true</blockWind><passability>PassThroughOnly</passability><fillPercent>0.5</fillPercent><size>(3,5)</size><drawHighlight>true</drawHighlight><highlightColor>(0.25,0.75,0.62)</highlightColor><uiIconScale>1</uiIconScale>
    <graphicData><graphicClass>Graphic_Multi</graphicClass><texPath>Things/Building/Wraith/Shuttle/WNG_WraithDart</texPath><shaderType>CutoutComplex</shaderType><drawSize>(3.3,5.5)</drawSize><shadowData><volume>(1.8,1.0,4.1)</volume><offset>(-0.1,0,0)</offset></shadowData></graphicData>
    <statBases><MaxHitPoints>760</MaxHitPoints><Flammability>0.12</Flammability><WorkToBuild>38000</WorkToBuild><Mass>90</Mass><Comfort>0.58</Comfort></statBases><tickerType>Normal</tickerType>
    <canOverlapZones>true</canOverlapZones><rotatable>true</rotatable><hasInteractionCell>true</hasInteractionCell><interactionCellOffset>(2,0,0)</interactionCellOffset><defaultPlacingRot>East</defaultPlacingRot><selectable>true</selectable><terrainAffordanceNeeded>Light</terrainAffordanceNeeded><soundImpactDefault>BulletImpact_Metal</soundImpactDefault><preventSkyfallersLandingOn>true</preventSkyfallersLandingOn><drawerType>RealtimeOnly</drawerType><repairEffect>ConstructDirt</repairEffect><forceDebugSpawnable>true</forceDebugSpawnable>
    <building><claimable>false</claimable><paintable>false</paintable><isInert>true</isInert><destroySound>BuildingDestroyed_Wood_Big</destroySound><forcedCostLeavings><li MayRequire="Ludeon.RimWorld.Odyssey">ShuttleEngine</li></forcedCostLeavings></building>
    <inspectorTabs><li>ITab_ContentsTransporter</li></inspectorTabs>
    <comps>
      <li Class="CompProperties_Transporter"><massCapacity>320</massCapacity><max1PerGroup>true</max1PerGroup><canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting><pawnLoadedSound>Shuttle_PawnLoaded</pawnLoadedSound><pawnExitSound>Shuttle_PawnExit</pawnExitSound><showMassInInspectString>true</showMassInInspectString></li>
      <li Class="CompProperties_Refuelable"><fuelCapacity>300</fuelCapacity><targetFuelLevelConfigurable>true</targetFuelLevelConfigurable><initialConfigurableTargetFuelLevel>300</initialConfigurableTargetFuelLevel><fuelFilter><thingDefs><li>WNG_WraithBiofluidFuel</li></thingDefs></fuelFilter><fuelLabel>wraith bio-fluid</fuelLabel><fuelGizmoLabel>Bio-fluid</fuelGizmoLabel><consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed><autoRefuelPercent>1</autoRefuelPercent><showFuelGizmo>true</showFuelGizmo><drawOutOfFuelOverlay>false</drawOutOfFuelOverlay><showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle><canEjectFuel>true</canEjectFuel></li>
      <li Class="CompProperties_AmbientSound"><sound>WNG_WraithDartDrive</sound></li>
    </comps><placeWorkers><li>PlaceWorker_NotUnderRoof</li></placeWorkers>
  </ThingDef>
  <ThingDef ParentName="WNG_WraithDartBase"><defName>WNG_WraithDart</defName><designationCategory>Misc</designationCategory><constructionSkillPrerequisite>8</constructionSkillPrerequisite><costList><WNG_Biomass>220</WNG_Biomass><GravlitePanel>40</GravlitePanel><ComponentIndustrial>4</ComponentIndustrial><ShuttleEngine>1</ShuttleEngine></costList><researchPrerequisites><li>Shuttles</li><li>WNG_OrganicFlight</li></researchPrerequisites><uiOrder>2601</uiOrder><comps><li Class="CompProperties_Shuttle"><shipDef>WNG_Ship_WraithDart</shipDef></li><li Class="CompProperties_Launchable"><fuelPerTile>2.4</fuelPerTile><minFuelCost>35</minFuelCost><skyfallerLeaving>WNG_WraithDartLeaving</skyfallerLeaving><worldObjectDef>WNG_WraithDartWorld</worldObjectDef><cooldownTicks>3000</cooldownTicks><fixedLaunchDistanceMax>78</fixedLaunchDistanceMax><cooldownEndedMessage>{0} is ready to launch again.</cooldownEndedMessage></li></comps></ThingDef>
  <ThingDef ParentName="WNG_WraithDartBase"><defName>WNG_WraithDart_NPC</defName><label>hostile Wraith Dart</label><description>A Wraith culling Dart on a hostile harvesting run. Its living control tissue can be hacked before escape. A completed hack forces an irreversible choice: rematerialize the exact absorbed pawns and forfeit the Dart, or keep the Dart while its buffered captives complete transfer into persistent Wraith custody for a later rescue.</description><building><claimable>false</claimable><neverBuildable>true</neverBuildable><paintable>false</paintable><isInert>true</isInert></building><comps><li Class="CompProperties_Shuttle"><shipDef>WNG_Ship_WraithDartNPC</shipDef></li><li Class="CompProperties_Launchable"><fuelPerTile>2.4</fuelPerTile><minFuelCost>35</minFuelCost><skyfallerLeaving>WNG_WraithDartLeaving</skyfallerLeaving><worldObjectDef>WNG_WraithDartWorld</worldObjectDef><cooldownTicks>3000</cooldownTicks><fixedLaunchDistanceMax>78</fixedLaunchDistanceMax><cooldownEndedMessage>{0} is ready to launch again.</cooldownEndedMessage></li><li Class="WraithNaniteGravtech.CompProperties_WraithDartMission"><retreatDelayTicks>7200</retreatDelayTicks></li><li Class="WraithNaniteGravtech.CompProperties_WraithDartHackable"><defence>4000</defence><effectHacking>HackingTerminal</effectHacking><lockoutDurationHoursRange>2~5</lockoutDurationHoursRange><notHackedInspectString>Living Dart controls remain hostile. Hack to choose between freeing buffered captives or seizing the craft.</notHackedInspectString><hackedInspectString>Living controls reconfigured for the colony.</hackedInspectString><showProgressAfterHackCompletion>false</showProgressAfterHackCompletion><hackedMessage>{HACKER_labelShort} has breached {SUBJECT_labelNoParenthesisDef}'s living control tissue.</hackedMessage><intellectualSkillPrerequisite>6</intellectualSkillPrerequisite></li></comps></ThingDef>
</Defs>
