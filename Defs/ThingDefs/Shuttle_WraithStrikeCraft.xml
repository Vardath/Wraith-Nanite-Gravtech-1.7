    <statBases><MaxHitPoints>1120</MaxHitPoints><Flammability>0.10</Flammability><WorkToBuild>56000</WorkToBuild><Mass>145</Mass><Comfort>0.64</Comfort></statBases>
    <tickerType>Normal</tickerType><designationCategory>Misc</designationCategory><constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <costList><WNG_Biomass>380</WNG_Biomass><GravlitePanel>70</GravlitePanel><ComponentSpacer>4</ComponentSpacer><ShuttleEngine>1</ShuttleEngine></costList>
    <canOverlapZones>true</canOverlapZones><rotatable>true</rotatable><hasInteractionCell>true</hasInteractionCell><interactionCellOffset>(3,0,0)</interactionCellOffset><defaultPlacingRot>East</defaultPlacingRot><selectable>true</selectable><terrainAffordanceNeeded>Light</terrainAffordanceNeeded><soundImpactDefault>BulletImpact_Metal</soundImpactDefault><preventSkyfallersLandingOn>true</preventSkyfallersLandingOn><drawerType>RealtimeOnly</drawerType><repairEffect>ConstructDirt</repairEffect><forceDebugSpawnable>true</forceDebugSpawnable>
    <building><claimable>false</claimable><destroySound>BuildingDestroyed_Wood_Big</destroySound><paintable>false</paintable><isInert>true</isInert><forcedCostLeavings><li MayRequire="Ludeon.RimWorld.Odyssey">ShuttleEngine</li></forcedCostLeavings></building>
    <inspectorTabs><li>ITab_ContentsTransporter</li></inspectorTabs>
    <researchPrerequisites><li>Shuttles</li><li>WNG_StrikeCraftBiology</li></researchPrerequisites>
    <comps>
      <li Class="CompProperties_Shuttle"><shipDef>WNG_Ship_WraithStrikeCraft</shipDef></li>
      <li Class="CompProperties_Launchable"><fuelPerTile>2.5</fuelPerTile><minFuelCost>42</minFuelCost><skyfallerLeaving>WNG_WraithStrikeCraftLeaving</skyfallerLeaving><worldObjectDef>WNG_WraithStrikeCraftWorld</worldObjectDef><cooldownTicks>3600</cooldownTicks><fixedLaunchDistanceMax>105</fixedLaunchDistanceMax><cooldownEndedMessage>{0} is ready to launch again.</cooldownEndedMessage></li>
      <li Class="CompProperties_Transporter"><massCapacity>900</massCapacity><max1PerGroup>true</max1PerGroup><canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting><pawnLoadedSound>Shuttle_PawnLoaded</pawnLoadedSound><pawnExitSound>Shuttle_PawnExit</pawnExitSound><showMassInInspectString>true</showMassInInspectString></li>
