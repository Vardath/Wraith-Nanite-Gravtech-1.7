  <ThingDef ParentName="BuildingBase">
    <defName>WNG_WraithStrikeCraft</defName><label>Wraith strike craft</label>
    <description>A fast Wraith assault and troop-transport organism grown beyond Dart scale. Its living hull metabolises carried Biomass to repair damage while landed, while cultivated Wraith bio-fluid feeds its native Odyssey shuttle flight organs.</description>
    <thingClass>Building_PassengerShuttle</thingClass><preventDroppingThingsOn>true</preventDroppingThingsOn><altitudeLayer>Building</altitudeLayer><pathCost>60</pathCost><blockWind>true</blockWind><passability>PassThroughOnly</passability><fillPercent>0.55</fillPercent><size>(4,6)</size><drawHighlight>true</drawHighlight><highlightColor>(0.20,0.74,0.61)</highlightColor><uiIconScale>1</uiIconScale>
