<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>WNG_WhispersHybridTissue</defName>
    <label>Whispers hybrid tissue</label>
    <description>A preserved biopsy from one of Michael's blind early hybrids, containing altered auditory structures and neck-gill tissue responsible for its predatory fog.</description>
    <graphicData>
      <texPath>Things/Item/Whispers/WNG_WhispersHybridTissue</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>25</stackLimit>
    <rotatable>false</rotatable>
    <statBases>
      <MarketValue>165</MarketValue>
      <Mass>0.03</Mass>
      <MaxHitPoints>40</MaxHitPoints>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <tradeability>Sellable</tradeability>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
    <defName>WNG_WhispersHybridStudyGate</defName>
