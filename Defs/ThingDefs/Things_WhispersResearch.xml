    <description>Completed biological analysis of Michael's blind fog-producing early hybrid.</description>
    <graphicData>
      <texPath>Things/Item/Whispers/WNG_WhispersHybridTissue</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <selectable>false</selectable>
    <alwaysHaulable>false</alwaysHaulable>
    <tradeability>None</tradeability>
    <generateAllowChance>0</generateAllowChance>
    <comps>
      <li Class="WraithNaniteGravtech.Anomaly.CompProperties_WNGStudyGateAnalyzable">
        <analysisID>860109</analysisID>
        <analysisRequiredRange>1</analysisRequiredRange>
        <activateTexPath>UI/Icons/Study</activateTexPath>
      </li>
    </comps>
  </ThingDef>
