  <ThingDef ParentName="ApparelBase">
    <defName>WNG_WraithUniform</defName>
    <recipeMaker IsNull="True" />
    <label>wraith uniform</label>
    <thingCategories Inherit="False"><li>ApparelMisc</li></thingCategories>
    <description>A fitted everyday Wraith uniform built from dark leather, reptile-pattern leather and flexible hive-grown fabric. It is ordinary caste-neutral clothing rather than a combat shell.</description>
    <techLevel>Spacer</techLevel>
    <smeltable>true</smeltable>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Wraith/WNG_WraithUniform</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>160</MaxHitPoints>
      <WorkToMake>10000</WorkToMake>
      <Mass>1.8</Mass>
      <EquipDelay>1.2</EquipDelay>
      <ArmorRating_Sharp>0.18</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
      <ArmorRating_Heat>0.20</ArmorRating_Heat>
    </statBases>
    <apparel>
      <bodyPartGroups><li>Torso</li><li>Neck</li><li>Shoulders</li><li>Arms</li></bodyPartGroups>
      <layers><li>OnSkin</li></layers>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Wraith/WNG_WraithUniform</wornGraphicPath>
      <tags><li>WraithClothing</li><li>WraithUniform</li></tags>
      <defaultOutfitTags><li>Worker</li><li>Soldier</li><li>Spacefarer</li></defaultOutfitTags>
    </apparel>
  
    <smeltProducts><WNG_IratusPheromones>1</WNG_IratusPheromones></smeltProducts>
  </ThingDef>

  <ThingDef ParentName="ApparelBase">
    <defName>WNG_WraithCommandArmor</defName>
    <recipeMaker IsNull="True" />
