    <statBases><MaxHitPoints>260</MaxHitPoints><WorkToMake>24000</WorkToMake><Mass>8</Mass><EquipDelay>3.5</EquipDelay><ArmorRating_Sharp>1.25</ArmorRating_Sharp><ArmorRating_Blunt>0.55</ArmorRating_Blunt><ArmorRating_Heat>0.65</ArmorRating_Heat></statBases>
    <costList><WNG_Biomass>45</WNG_Biomass><ComponentIndustrial>1</ComponentIndustrial></costList>
    <apparel><bodyPartGroups><li>Torso</li><li>Neck</li><li>Shoulders</li><li>Arms</li><li>Legs</li></bodyPartGroups><layers><li>Shell</li></layers><wornGraphicPath>Things/Pawn/Humanlike/Apparel/Wraith/WNG_WarriorCarapace</wornGraphicPath><tags><li>WraithArmor</li><li>WraithWarriorArmor</li></tags><defaultOutfitTags><li>Soldier</li></defaultOutfitTags></apparel>
  
