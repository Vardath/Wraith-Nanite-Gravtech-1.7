      <tags><li>WraithArmor</li><li>WraithCommandArmor</li></tags>
      <defaultOutfitTags><li>Soldier</li></defaultOutfitTags>
    </apparel>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WraithLivingEquipmentMaturation" />
