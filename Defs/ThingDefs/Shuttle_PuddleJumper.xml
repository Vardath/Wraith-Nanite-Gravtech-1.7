  <ThingDef ParentName="BuildingBase">
    <defName>WNG_PuddleJumper</defName><label>Puddle Jumper</label>
    <description>A compact Ancient-derived Puddle Jumper using Odyssey's native passenger-shuttle lifecycle. Stabilized Asuran nanite slurry fuels launch and cloak systems. An Ancient/ATA-compatible pawn aboard is required to authorize launch, cloak and neural sensor operation. Compatibility comes from the natural Ancient activation gene, a successfully retained artificial control interface, or the equivalent Asuran synthetic handshake. After Ancient drone-control research, the finite reconstructed-drone launcher can be commanded either by a compatible pawn aboard or by an occupied allied Ancient control chair within its 72-cell neural network.</description>
    <thingClass>Building_PassengerShuttle</thingClass><preventDroppingThingsOn>true</preventDroppingThingsOn><altitudeLayer>Building</altitudeLayer><pathCost>50</pathCost><blockWind>true</blockWind><passability>PassThroughOnly</passability><fillPercent>0.5</fillPercent><size>(3,5)</size><drawHighlight>true</drawHighlight><highlightColor>(0.48,0.82,0.95)</highlightColor><uiIconScale>1</uiIconScale>
    <graphicData><graphicClass>Graphic_Multi</graphicClass><texPath>Things/Building/Precursor/Shuttle/WNG_PuddleJumper</texPath><shaderType>CutoutComplex</shaderType><drawSize>(4.2,5.5)</drawSize><shadowData><volume>(2.3,1.0,4.1)</volume><offset>(-0.1,0,0)</offset></shadowData></graphicData>
    <statBases><MaxHitPoints>850</MaxHitPoints><Flammability>0</Flammability><WorkToBuild>44000</WorkToBuild><Mass>82</Mass><Comfort>0.82</Comfort></statBases>
    <tickerType>Normal</tickerType><designationCategory>Misc</designationCategory><constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <costList><Plasteel>180</Plasteel><GravlitePanel>55</GravlitePanel><ComponentSpacer>4</ComponentSpacer><ShuttleEngine>1</ShuttleEngine></costList>
    <canOverlapZones>true</canOverlapZones><rotatable>true</rotatable><hasInteractionCell>true</hasInteractionCell><interactionCellOffset>(2,0,0)</interactionCellOffset><defaultPlacingRot>East</defaultPlacingRot><selectable>true</selectable><terrainAffordanceNeeded>Light</terrainAffordanceNeeded><soundImpactDefault>BulletImpact_Metal</soundImpactDefault><preventSkyfallersLandingOn>true</preventSkyfallersLandingOn><drawerType>RealtimeOnly</drawerType><repairEffect>ConstructMetal</repairEffect><forceDebugSpawnable>true</forceDebugSpawnable>
    <building><claimable>false</claimable><paintable>false</paintable><isInert>true</isInert><destroySound>BuildingDestroyed_Metal_Big</destroySound><forcedCostLeavings><li MayRequire="Ludeon.RimWorld.Odyssey">ShuttleEngine</li></forcedCostLeavings></building>
    <inspectorTabs><li>ITab_ContentsTransporter</li></inspectorTabs>
    <researchPrerequisites><li>Shuttles</li><li>WNG_SkimmerSystems</li></researchPrerequisites>
    <comps>
      <li Class="CompProperties_Shuttle"><shipDef>WNG_Ship_PuddleJumper</shipDef></li>
      <li Class="WraithNaniteGravtech.CompProperties_AncientPuddleJumperLaunchable"><fuelPerTile>0.02</fuelPerTile><minFuelCost>0.2</minFuelCost><skyfallerLeaving>WNG_PuddleJumperLeaving</skyfallerLeaving><worldObjectDef>WNG_PuddleJumperWorld</worldObjectDef><cooldownTicks>2400</cooldownTicks><fixedLaunchDistanceMax>95</fixedLaunchDistanceMax><cooldownEndedMessage>{0} is ready to launch again.</cooldownEndedMessage></li>
      <li Class="CompProperties_Transporter"><massCapacity>650</massCapacity><max1PerGroup>true</max1PerGroup><canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting><pawnLoadedSound>Shuttle_PawnLoaded</pawnLoadedSound><pawnExitSound>Shuttle_PawnExit</pawnExitSound><showMassInInspectString>true</showMassInInspectString></li>
      <li Class="CompProperties_Refuelable"><fuelCapacity>4</fuelCapacity><targetFuelLevelConfigurable>true</targetFuelLevelConfigurable><initialConfigurableTargetFuelLevel>4</initialConfigurableTargetFuelLevel><fuelFilter><thingDefs><li>WNG_AsuranNaniteSlurry</li></thingDefs></fuelFilter><fuelLabel>Asuran nanite slurry</fuelLabel><fuelGizmoLabel>Nanite slurry</fuelGizmoLabel><consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed><autoRefuelPercent>1</autoRefuelPercent><showFuelGizmo>true</showFuelGizmo><drawOutOfFuelOverlay>false</drawOutOfFuelOverlay><showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle><canEjectFuel>true</canEjectFuel></li>
      <li Class="CompProperties_AmbientSound"><sound>ShuttleIdle_Ambience</sound></li>
      <li Class="WraithNaniteGravtech.CompProperties_PuddleJumperDroneArmament"><droneRange>72</droneRange><droneCooldownTicks>900</droneCooldownTicks><researchDefName>WNG_AncientDroneControl</researchDefName><ammoDefName>WNG_AncientDrone</ammoDefName><projectileDefName>WNG_AncientDroneProjectile</projectileDefName></li>
      <li Class="WraithNaniteGravtech.CompProperties_PuddleJumperSystems"><cloakFuelPerRareTick>0.0025</cloakFuelPerRareTick><cloakCooldownTicks>1200</cloakCooldownTicks><sensorCooldownTicks>2500</sensorCooldownTicks></li>
    </comps>
    <placeWorkers><li>PlaceWorker_NotUnderRoof</li></placeWorkers><uiOrder>2602</uiOrder>
  </ThingDef>
</Defs>
