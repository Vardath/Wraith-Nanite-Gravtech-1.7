<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Retained Asuran/Precursor settlement structures with dedicated settlement presentation. -->
  <ThingDef ParentName="Wall">
    <defName>WNG_PrecursorWall</defName>
    <label>precursor wall</label>
    <description>A seamless Asuran composite wall built from pale segmented field-bearing material, crossed by luminous field seams and reinforced corner nodes.</description>
    <graphicData>
      <texPath>Things/Building/Precursor/Gravship/WNG_PrecursorHull_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <linkType>CornerFiller</linkType>
      <linkFlags Inherit="False"><li>Wall</li><li>Rock</li></linkFlags>
    </graphicData>
    <uiIconPath>UI/WNG/Build/WNG_PrecursorWall</uiIconPath>
    <stuffCategories Inherit="False"/>
    <costStuffCount>0</costStuffCount>
    <useStuffTerrainAffordance>false</useStuffTerrainAffordance>
    <costList><Plasteel>4</Plasteel><ComponentIndustrial>1</ComponentIndustrial></costList>
    <statBases><MaxHitPoints>520</MaxHitPoints><WorkToBuild>260</WorkToBuild><Flammability>0</Flammability><Beauty>5</Beauty></statBases>
    <tickerType>Rare</tickerType>
    <designationCategory>Structure</designationCategory>
    <researchPrerequisites><li>WNG_PrecursorFabrication</li></researchPrerequisites>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_AsuranArchiveRepair"><repairIntervalTicks>1200</repairIntervalTicks><healPerPulse>2</healPerPulse><archiveRadius>45</archiveRadius></li>
    </comps>
    <building><isAirtight>true</isAirtight><isStuffableAirtight>false</isStuffableAirtight></building>
  </ThingDef>

  <ThingDef ParentName="DoorBase">
    <defName>WNG_PrecursorDoor</defName>
    <label>precursor iris door</label>
    <description>A fast powered Asuran composite iris partition using the same field-bearing architecture as precursor settlement walls.</description>
    <rotatable>false</rotatable>
    <graphicData>
      <texPath>Things/Building/Precursor/Structure/WNG_PrecursorDoor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <damageData><enabled>false</enabled></damageData>
          <linkFlags><li>Wall</li><li>Rock</li></linkFlags>
    </graphicData>
    <stuffCategories Inherit="False"/>
    <costStuffCount>0</costStuffCount>
    <useStuffTerrainAffordance>false</useStuffTerrainAffordance>
    <costList><Plasteel>28</Plasteel><ComponentSpacer>1</ComponentSpacer></costList>
    <statBases><MaxHitPoints>350</MaxHitPoints><WorkToBuild>1500</WorkToBuild><Flammability>0</Flammability><Beauty>4</Beauty></statBases>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>35</basePowerConsumption></li>
      <li Class="CompProperties_Breakdownable"/>
          <li Class="WraithNaniteGravtech.CompProperties_AsuranArchiveRepair"><repairIntervalTicks>900</repairIntervalTicks><healPerPulse>3</healPerPulse><archiveRadius>45</archiveRadius></li>
    </comps>
    <designationCategory>Structure</designationCategory>
    <researchPrerequisites><li>WNG_PrecursorFabrication</li><li>Autodoors</li></researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <placeWorkers Inherit="False">
      <li>PlaceWorker_DoorLearnOpeningSpeed</li>
    </placeWorkers>
    <building>
      <canPlaceOverWall>true</canPlaceOverWall>
      <blueprintClass>Blueprint_Door</blueprintClass>
      <paintable>false</paintable>
    </building>
  </ThingDef>
</Defs>
