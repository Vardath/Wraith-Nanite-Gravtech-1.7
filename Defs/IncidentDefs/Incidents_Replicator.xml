  <IncidentDef>
    <defName>WNG_ReplicatorMatterMeteorShower</defName>
    <label>Replicator Matter fall</label>
    <category>ThreatSmall</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>WraithNaniteGravtech.IncidentWorker_ReplicatorMatterMeteorShower</workerClass>
    <baseChance>0.065</baseChance>
    <earliestDay>10</earliestDay>
    <minRefireDays>18</minRefireDays>
