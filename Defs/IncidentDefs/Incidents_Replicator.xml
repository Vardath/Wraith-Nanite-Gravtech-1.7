<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <IncidentDef>
    <defName>WNG_ReplicatorConsumedRuinDiscovery</defName>
    <label>Replicator-consumed ruin discovery</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
