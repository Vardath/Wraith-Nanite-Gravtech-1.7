    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>WraithNaniteGravtech.IncidentWorker_ReplicatorContaminatedCargo</workerClass>
    <baseChance>0.055</baseChance>
    <earliestDay>14</earliestDay>
    <minRefireDays>20</minRefireDays>
    <populationEffect>None</populationEffect>
    <pointsScaleable>false</pointsScaleable>
