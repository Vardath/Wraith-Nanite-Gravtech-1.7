<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>WNG_IratusAttached</defName>
    <label>Iratus bug attached</label>
    <description>A living Iratus bug is physically clamped around the neck and feeding from the victim. The organism itself remains attached to this exact patient; the severity shown here represents the worsening physiological drain, not a replacement for the creature.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <lethalSeverity>1</lethalSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <label>latched</label>
        <painOffset>0.15</painOffset>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.10</offset></li>
          <li><capacity>Consciousness</capacity><offset>-0.05</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.25</minSeverity>
        <label>feeding</label>
        <painOffset>0.30</painOffset>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.35</offset></li>
          <li><capacity>Consciousness</capacity><offset>-0.10</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.50</minSeverity>
        <label>deep feeding</label>
        <painOffset>0.45</painOffset>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.65</offset></li>
          <li><capacity>Consciousness</capacity><offset>-0.20</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <label>paralytic</label>
        <painOffset>0.50</painOffset>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li><capacity>Moving</capacity><setMax>0.10</setMax></li>
          <li><capacity>Consciousness</capacity><offset>-0.35</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.92</minSeverity>
        <label>terminal drain</label>
        <painOffset>0.55</painOffset>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li><capacity>Moving</capacity><setMax>0.05</setMax></li>
          <li><capacity>Consciousness</capacity><setMax>0.20</setMax></li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="WraithNaniteGravtech.Anomaly.HediffCompProperties_IratusAttachment">
        <severityPerDay>0.45</severityPerDay>
        <failedRemovalSeverity>0.18</failedRemovalSeverity>
      </li>
  </comps>
  </HediffDef>
</Defs>
