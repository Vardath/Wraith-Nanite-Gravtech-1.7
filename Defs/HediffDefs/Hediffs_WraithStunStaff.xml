<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>WNG_StunStaffParalysis</defName>
    <label>stun-staff paralysis</label>
    <description>A Wraith capture discharge has locked the pawn's major motor pathways. Voluntary movement and manipulation are temporarily suppressed while the accompanying anesthetic state keeps the target unconscious for safe transport or captivity.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <duplicationAllowed>false</duplicationAllowed>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1200~1200</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.00</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <setMax>0.00</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
