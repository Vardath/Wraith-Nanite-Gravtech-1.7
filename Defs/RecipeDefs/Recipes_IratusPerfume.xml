    <fixedIngredientFilter>
      <thingDefs>
        <li>WNG_IratusPheromones</li>
        <li>PsychoidLeaves</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products><WNG_IratusPerfume>1</WNG_IratusPerfume></products>
  </RecipeDef>
</Defs>
