    <recipeUsers><li>DrugLab</li></recipeUsers>
    <ingredients>
      <li><filter><thingDefs><li>WNG_IratusPheromones</li></thingDefs></filter><count>1</count></li>
      <li><filter><thingDefs><li>PsychoidLeaves</li></thingDefs></filter><count>6</count></li>
      <li><filter><thingDefs><li>Neutroamine</li></thingDefs></filter><count>3</count></li>
