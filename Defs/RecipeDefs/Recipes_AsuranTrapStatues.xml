<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>Make_WNG_AsuranSleeperStatue</defName>
    <label>make Asuran lattice sculpture</label>
    <description>Manufacture an Asuran lattice sculpture from nanite slurry and advanced materials. Only an Asuran nanite synthetic can perform the pattern-forming work.</description>
    <jobString>Making Asuran lattice sculpture.</jobString>
    <workAmount>32000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Artistic</workSkill>
    <requiredGiverWorkType>WNG_AsuranFabrication</requiredGiverWorkType>
    <researchPrerequisite>WNG_PrecursorFabrication</researchPrerequisite>
    <skillRequirements><Artistic>6</Artistic></skillRequirements>
    <ingredients>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>35</count></li>
      <li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>1</count></li>
      <li><filter><thingDefs><li>WNG_AsuranNaniteSlurry</li></thingDefs></filter><count>30</count></li>
      <li><filter><thingDefs><li>Silver</li></thingDefs></filter><count>100</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Plasteel</li><li>ComponentSpacer</li><li>WNG_AsuranNaniteSlurry</li><li>Silver</li></thingDefs></fixedIngredientFilter>
    <products><WNG_AsuranSleeperStatue>1</WNG_AsuranSleeperStatue></products>
    <recipeUsers>
      <li>TableSculpting</li>
    </recipeUsers>
    <effectWorking>Sculpt</effectWorking>
    <soundWorking>Recipe_Sculpt</soundWorking>
  </RecipeDef>

