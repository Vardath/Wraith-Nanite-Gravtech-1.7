    <jobString>Attempting feeding-independence therapy on TargetA.</jobString>
    <researchPrerequisite>WNG_WraithFeedingIndependence</researchPrerequisite>
    <workAmount>1800</workAmount>
    <hideBodyPartNames>true</hideBodyPartNames>
    <targetsBodyPart>false</targetsBodyPart>
    <anesthetize>true</anesthetize>
    <skillRequirements><Medicine>12</Medicine></skillRequirements>
    <ingredients>
      <li><filter><thingDefs><li>WNG_FeedingIndependenceVector</li></thingDefs></filter><count>1</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>WNG_FeedingIndependenceVector</li></thingDefs></fixedIngredientFilter>
  </RecipeDef>
</Defs>
