      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options><WNG_HumanFormReplicator>9</WNG_HumanFormReplicator><WNG_PrecursorEngineer>5</WNG_PrecursorEngineer><WNG_PrecursorCommander>1</WNG_PrecursorCommander></options>
