<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Combat Extended-only precursor pulse ammunition. Ordinary WNG remains ammunition-free. -->
  <CombatExtended.AmmoSetDef>
    <defName>WNG_CE_AmmoSet_PrecursorPulse</defName>
    <label>precursor pulse cell</label>
    <ammoTypes><WNG_CE_Ammo_PrecursorPulseCell>WNG_CE_Projectile_PrecursorPulse</WNG_CE_Ammo_PrecursorPulseCell></ammoTypes>
  </CombatExtended.AmmoSetDef>

  <ThingDef Class="CombatExtended.AmmoDef" ParentName="SpacerSmallAmmoBase">
    <defName>WNG_CE_Ammo_PrecursorPulseCell</defName>
    <label>precursor pulse cell</label>
    <description>A compact high-density field cell used by precursor pulse weapons when Combat Extended is active.</description>
    <graphicData><texPath>Things/Item/Resource/Precursor/WNG_VacuumEnergyModule</texPath><graphicClass>Graphic_StackCount</graphicClass></graphicData>
    <statBases><Mass>0.022</Mass><Bulk>0.016</Bulk></statBases>
    <ammoClass>Charged</ammoClass>
    <cookOffProjectile>WNG_CE_Projectile_PrecursorPulse</cookOffProjectile>
  </ThingDef>

  <ThingDef ParentName="BaseBulletCE">
    <defName>WNG_CE_Projectile_PrecursorPulse</defName>
    <label>precursor pulse</label>
    <graphicData><texPath>Things/Projectile/Charge_Small</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <damageDef>Bullet</damageDef><damageAmountBase>18</damageAmountBase>
      <armorPenetrationSharp>11</armorPenetrationSharp><armorPenetrationBlunt>34</armorPenetrationBlunt><speed>95</speed>
    </projectile>
  </ThingDef>

  <RecipeDef ParentName="AmmoRecipeBase">
    <defName>WNG_CE_Make_PrecursorPulseCell</defName>
    <label>fabricate precursor pulse cells x120</label>
    <jobString>Fabricating precursor pulse cells.</jobString>
    <researchPrerequisite>WNG_PrecursorFabrication</researchPrerequisite>
    <workAmount>1100</workAmount><workSkill>Crafting</workSkill>
    <ingredients>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>2</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>1</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Plasteel</li><li>ComponentIndustrial</li></thingDefs></fixedIngredientFilter>
    <products><WNG_CE_Ammo_PrecursorPulseCell>120</WNG_CE_Ammo_PrecursorPulseCell></products>
    <recipeUsers><li>WNG_PrecursorFabricator</li></recipeUsers>
  </RecipeDef>
</Defs>