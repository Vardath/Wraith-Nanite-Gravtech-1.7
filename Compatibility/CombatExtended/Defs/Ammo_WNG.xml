<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Combat Extended-only ammunition. This folder is loaded only when
    CETeam.CombatExtended is active, so ordinary WNG play remains ammo-free.
    Each ranged WNG weapon receives its own ammunition identity even where
    a family shares retained visual language.
  -->

  <!-- ==================== Wraith ammo sets ==================== -->
  <CombatExtended.AmmoSetDef>
    <defName>WNG_CE_AmmoSet_WraithStunStaff</defName>
    <label>Wraith stun-staff biocharge</label>
    <ammoTypes><WNG_CE_Ammo_WraithStunStaffCharge>WNG_CE_Projectile_WraithStunStaff</WNG_CE_Ammo_WraithStunStaffCharge></ammoTypes>
  </CombatExtended.AmmoSetDef>
