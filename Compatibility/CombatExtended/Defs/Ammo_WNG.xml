  <!-- ==================== Wraith ammunition ==================== -->
  <ThingDef Class="CombatExtended.AmmoDef" ParentName="SpacerSmallAmmoBase">
    <defName>WNG_CE_Ammo_WraithStunStaffCharge</defName>
    <label>stun-staff biocharge</label>
    <description>A sealed living electrocyte pack grown to recharge a Wraith stun staff under Combat Extended. Wraith weapons do not require ammunition when Combat Extended is absent.</description>
    <graphicData><texPath>Things/Item/Resource/WNG_Biomass</texPath><graphicClass>Graphic_StackCount</graphicClass></graphicData>
    <statBases><Mass>0.025</Mass><Bulk>0.02</Bulk></statBases>
    <ammoClass>Charged</ammoClass>
    <cookOffProjectile>WNG_CE_Projectile_WraithStunStaff</cookOffProjectile>
  </ThingDef>
  <ThingDef Class="CombatExtended.AmmoDef" ParentName="SpacerSmallAmmoBase">
    <defName>WNG_CE_Ammo_WraithStunnerCharge</defName>
