  <!-- ==================== Explicit crafting recipes ==================== -->
  <RecipeDef ParentName="AmmoRecipeBase">
    <defName>WNG_CE_Make_WraithStunStaffCharge</defName><label>grow stun-staff biocharges x30</label><jobString>Growing stun-staff biocharges.</jobString>
    <researchPrerequisite>WNG_LivingWeapons</researchPrerequisite><workAmount>600</workAmount><workSkill>Crafting</workSkill>
    <ingredients><li><filter><thingDefs><li>WNG_Biomass</li></thingDefs></filter><count>2</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>WNG_Biomass</li></thingDefs></fixedIngredientFilter>
    <products><WNG_CE_Ammo_WraithStunStaffCharge>30</WNG_CE_Ammo_WraithStunStaffCharge></products><recipeUsers><li>WNG_LivingForge</li></recipeUsers>
  </RecipeDef>
