<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WraithNaniteGravtech</AssemblyName>
    <RootNamespace>WraithNaniteGravtech</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../../1.7/Assemblies/</OutputPath>
    <DebugType>portable</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <WNGSourceCommit Condition="'$(WNGSourceCommit)' == ''">UNSPECIFIED</WNGSourceCommit>
    <WNGSourceFingerprint Condition="'$(WNGSourceFingerprint)' == ''">UNSPECIFIED</WNGSourceFingerprint>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="WNGSourceCommit" Value="$(WNGSourceCommit)" />
    <AssemblyMetadata Include="WNGSourceFingerprint" Value="$(WNGSourceFingerprint)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4977-alpha.1" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" />
  </ItemGroup>
</Project>
