    "design_rules": {
      "material_priority": [
        [
          "gold_black_reptile_leather_half_jacket",
          0.23
        ],
        [
          "black_patterned_velvet_sleeves_and_robe",
          0.18
        ],
        [
          "gold_black_structured_corset",
          0.2
        ],
        [
          "gold_torn_pattern_stretch_fabric",
          0.1
        ],
        [
          "gold_black_woven_riding_skirt_robe",
          0.16
        ],
        [
          "gloss_black_leather_side_inserts",
          0.06
        ],
        [
          "aged_metal_buttons_zipper_straps",
          0.04
        ],
        [
          "subtle_laser_cut_leather_or_latex_organic_detail",
          0.03
        ]
      ],
      "construction": [
        "cropped gold reptile-pattern leather half-jacket over the upper torso",
        "black patterned velvet sleeves with soft nap and drape",
        "fitted gold-and-black corset with front straps across the chest",
        "integrated high neck collar as part of the corset construction",
        "front zipper and small metal button details",
        "gold torn-pattern fitted stretch-fabric underlayer",
        "split riding-skirt/robe lower construction so the Queen can move physically",
        "gold-black woven lower garment with glossy black leather side inserts",
        "restrained laser-cut leather or latex organic detailing only where supported by Queen production design"
      ],
      "motifs": [
        "regal predatory Wraith Queen tailoring",
        "reptile leather and patterned textile contrast",
        "corseted vertical authority",
        "high collar and chest-strap rank language",
        "flowing but physically functional lower robe",
        "subtle organic Wraith detail without turning clothing into a spaceship"
      ],
      "avoid": [
        "purple generic sci-fi armour",
        "anonymous panel shapes",
        "flat vector corset polygons",
        "neon piping",
        "huge gemstones",
        "superhero breastplate",
        "ship fins on shoulders",
        "uniform glow lines",
        "clean plastic surfaces",
        "cloud noise",
        "overly symmetrical geometric plate stacks"
      ]
    },
    "primary_research_basis": [
      "Propworx screen-used Teyla Wraith Queen costume technical description",
      "Val Halverson costume-designer Q&A covering Wraith Queen dress/armour, latex and leather",
      "Val Halverson wardrobe Q&A confirming the riding-skirt lower construction for physical movement"
    ]
  },
