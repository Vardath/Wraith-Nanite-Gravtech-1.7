{
  "id": "human_form_uniform",
  "item": "WNG_HumanFormUniform",
  "faction": "Asuran",
  "output_dir": "Precursor",
  "purpose": "Screen-inspired Stargate Atlantis Asuran / human-form Replicator fitted uniform translated into RimWorld as tailored high-technology clothing, not armour. It should read as a clean Ancient-derived garment with white-silver woven outer fabric, charcoal technical underlayer, restrained cyan inlay, practical stitched construction and subtle production wear.",
  "stage_1_stargate": {
    "sources": [
      {
        "url": "https://www.gateworld.net/news/2009/08/stitches-in-time/",
        "role": "Stargate Atlantis costume-construction context",
        "required_terms": [],
        "image_policy": "metadata_only"
      },
      {
        "url": "https://www.thepropgallery.com/hero-asuran-replicator-stunner-holster",
        "role": "screen-used Asuran prop material language",
        "required_terms": [],
        "image_policy": "metadata_only"
      },
      {
        "url": "https://www.spotern.com/en/product/8502",
        "role": "Asuran Replicator soldier wardrobe reference",
        "required_terms": [],
        "image_policy": "metadata_only"
      }
    ],
    "minimum_live_sources": 0,
    "minimum_visual_references": 0,
    "design_rules": {
      "material_priority": [
        [
          "white_silver_engineered_woven_uniform",
          0.4
        ],
        [
          "charcoal_technical_underlayer",
          0.24
        ],
        [
          "blue_grey_precursor_weave",
          0.16
        ],
        [
          "aged_gunmetal_fasteners",
          0.08
        ],
        [
          "restrained_cyan_thread_inlay",
          0.04
        ],
        [
          "stitched_seams_soft_folds_and_wear",
          0.08
        ]
      ],
      "construction": [
        "fitted high-collar Asuran uniform rather than armour",
        "soft white-silver engineered fabric as the visible base garment",
        "dark charcoal inset vest/placket running vertically through the torso",
        "curved blue-grey shoulder yoke shaped as sewn clothing",
        "tapered side inserts that create a tailored waist without humanoid limbs",
        "low-profile waistband with small aged gunmetal closures",
        "restrained cyan thread used only as sparse seam accents",
        "stitched seams, gentle cloth folds and directional wear",
        "RimWorld pawn silhouette remains authoritative"
      ],
      "motifs": [
        "Ancient/Atlantis clean tailoring",
        "Asuran precision with subtle material richness",
        "layered sewn garment construction",
        "dark central technical weave",
        "fine cyan thread accents rather than glowing piping",
        "screen-worn textile depth"
      ],
      "avoid": [
        "flat white polygons",
        "armour plates",
        "anonymous panels",
        "bright white shell",
        "generic marine armour",
        "cyan piping",
        "neon outlines",
        "superhero breastplate",
        "ship parts on clothing",
        "humanoid arms",
        "humanoid legs",
        "featureless grey blob"
      ]
    }
  },
