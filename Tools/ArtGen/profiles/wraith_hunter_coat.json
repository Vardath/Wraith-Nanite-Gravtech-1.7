    "design_rules": {
      "material_priority": [
        [
          "green_black_leather_trenchcoat",
          0.44
        ],
        [
          "black_reptile_pattern_leather_vest",
          0.22
        ],
        [
          "black_soft_leather_lapels_and_structure",
          0.13
        ],
        [
          "layered_textured_epaulettes",
          0.08
        ],
        [
          "dark_blue_satin_lining",
          0.04
        ],
        [
          "lacing_snaps_zipper_and_belt_hardware",
          0.05
        ],
        [
          "wear_rub_marks_and_handmade_variation",
          0.04
        ]
      ],
      "construction": [
        "long green leather trenchcoat with soft drape rather than rigid armor segmentation",
        "long black reptile-pattern leather vest worn beneath the coat",
        "layered textured epaulettes built as clothing pieces over the shoulders",
        "contrast leather lapels and inset construction around the front opening",
        "hidden snaps and zipper-like front closure hardware",
        "black side and back lacing for fit and visible hand-built construction",
        "dark blue satin lining visible only in narrow inner folds and vents",
        "motorcycle/rocker leather tailoring logic with Stargate Wraith refinement",
        "production wear, rubbed edges and small irregularities rather than sterile surfaces"
      ],
      "motifs": [
        "predatory longcoat silhouette",
        "three-piece Wraith costume logic",
        "reptile leather texture",
        "layered shoulder construction",
        "tailored vertical seam rhythm",
        "regal but worn Wraith commander finish"
      ],
      "avoid": [
        "armour plates where the screen costume is leather clothing",
        "anonymous panel shapes",
        "flat vector geometry",
        "purple armour with cyan lines",
        "uniform glowing piping",
        "ship parts pasted onto clothing",
        "superhero symmetry",
        "cloud noise as material",
        "muddy texture transfer",
        "oversized shoulder fins",
        "hard polygon hems or scalloped procedural edges"
      ]
    },
    "minimum_live_sources": 4,
    "minimum_visual_references": 1
  },
