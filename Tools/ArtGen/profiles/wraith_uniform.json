        "role": "screen_costume_variation_context",
        "required_terms": [
          "black jacket",
          "long dark brown coat",
          "Wraith"
        ],
        "image_policy": "metadata_only"
      }
    ],
    "minimum_live_sources": 3,
    "minimum_visual_references": 1,
    "primary_research_basis": [
      "Propworx screen-used Wraith male costume: green leather, black reptile-pattern leather vest, snaps, zipper, side/back lacing, leather trousers, gauntlets and motorcycle boots",
      "Val Halverson costume-designer Q&A: Wraith costumes are generally three-piece builds using 6–8 cow hides plus contrast leather, gauntlets and belts; later male designs use subtle differentiation rather than loud rank geometry",
      "screen-used Todd/commander costume evidence for long leather vest construction, concealed closures, textured gauntlets and production wear"
    ],
    "design_rules": {
      "material_priority": [
        [
          "dark_green_black_leather_uniform_shell",
          0.38
        ],
        [
          "black_reptile_pattern_leather_vest_and_yoke",
          0.24
        ],
        [
          "black_soft_leather_side_and_sleeve_structure",
          0.16
        ],
        [
          "subtle_dark_woven_underlayer",
          0.08
        ],
        [
          "snaps_zipper_lacing_and_belt_hardware",
          0.07
        ],
        [
          "production_wear_and_rubbed_edges",
          0.05
        ],
        [
          "restrained_organic_wraith_surface_detail",
          0.02
        ]
      ],
      "construction": [
        "fitted waist-length Wraith leather uniform rather than a long coat",
        "black reptile-pattern leather central vest and shoulder yoke",
        "dark green-black soft leather body and sleeves",
        "narrow contrast-leather collar and front placket",
        "hidden snaps and short zipper-like front closure",
        "side/back lacing for fit and visible handmade construction",
        "low-profile waistband/belt seam suitable beneath Wraith armour",
        "subtle asymmetry and production wear",
        "three-piece Wraith costume logic simplified for ordinary non-command clothing"
      ],
      "motifs": [
        "predatory fitted Wraith tailoring",
        "reptile leather texture",
        "vertical vest/placket rhythm",
        "practical leather construction",
        "dark organic restraint rather than luminous technology",
        "wardrobe continuity with Wraith commanders and hunters without their rank silhouette"
      ],
      "avoid": [
        "armour plates",
        "anonymous panels",
        "purple armour",
        "cyan piping",
        "generic futuristic bodysuit",
        "ship fins",
        "superhero symmetry",
        "flat vector geometry",
        "large rank ornaments",
        "cloud noise",
        "bright glowing faction lines"
      ]
    }
  },
