{
  "schema": 1,
  "description": "Permanent named regression catalogue for bugs actually encountered during WNG 1.6 rebuild/audit work.",
  "regressions": [
    {
      "id": "H001_all_bills_unavailable",
      "title": "All crafting bills unavailable",
      "tests": [
        ".github/artqa/bill_recipe_regression.py",
        ".github/artqa/production_routing.py",
        ".github/artqa/third_party_recipe_preservation.py",
        ".github/artqa/null_type_lifecycle.py"
      ],
      "guards": [
        {
          "path": ".github/artqa/production_routing.py",
          "contains": [
            "live recipeMaker is forbidden; use an explicit WNG RecipeDef"
          ]
        },
        {
          "path": "Defs/RecipeDefs/Recipes_WNGItemCrafting.xml",
          "contains": [
            "Explicit WNG item crafting recipes",
            "<recipeUsers>"
          ]
        },
        {
          "path": "Source/WraithNaniteGravtech/WNGDefSanitizer.cs",
          "contains": [
            "protect market-value and bill enumeration",
            "entry.thingDef == null"
          ]
        }
      ]
    },
    {
      "id": "H002_vanilla_recipes_disappeared",
      "title": "Vanilla recipes disappeared from workbenches",
      "tests": [
        ".github/artqa/bill_recipe_regression.py",
        ".github/artqa/third_party_recipe_preservation.py"
      ],
      "guards": [
        {
          "path": ".github/artqa/bill_recipe_regression.py",
          "contains": [
            "AvailableOnNow",
            "global"
          ]
        },
        {
          "path": ".github/artqa/third_party_recipe_preservation.py",
          "contains": [
            "global recipe collections",
            "approved_external_routes",
            "Missing approved external recipe route"
          ]
        },
        {
          "path": ".github/artqa/production_routing.py",
          "contains": [
            "approved_external_routes",
            "Missing approved vanilla workstation route"
          ]
        }
      ]
    },
    {
      "id": "H027_childs_toy_vanilla_mech_gestation",
      "title": "Child's Toy lost the vanilla Mechanitor gestation path",
      "tests": [
        ".github/artqa/bill_recipe_regression.py",
        ".github/artqa/production_routing.py",
        ".github/artqa/third_party_recipe_preservation.py"
      ],
      "guards": [
        {
          "path": "Defs/RecipeDefs/Recipes_ChildsToy.xml",
          "contains": [
            "ParentName=\"LightMechanoidRecipe\"",
            "<li>MechGestator</li>",
            "<researchPrerequisite>WNG_ReplicatorGestation</researchPrerequisite>"
          ],
          "not_contains": [
            "<li>WNG_PrecursorFabricator</li>"
          ]
        }
      ]
    },
    {
      "id": "H003_nanotech_nanofabricator_truncated",
